            raise HTTPException(status_code=400, detail="Failed to remove entity from ignored list")
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error removing ignored entity: {e}")
        raise HTTPException(status_code=500, detail="Internal server error")


# Integrated review endpoints (multi-session)

class IntegratedReviewRequest(BaseModel):
    """Request model for integrated review generation"""
    limit: int = Field(default=10, ge=1, le=50, description="Maximum number of sessions to include")
    days: int = Field(default=7, ge=1, le=30, description="Look back this many days for review data")
    force_refresh: bool = Field(default=False, description="Force refresh of cached data")
    api_key: Optional[str] = Field(default=None, description="API key for LLM calls (optional, uses backend default if not provided)")
    base_url: Optional[str] = Field(default=None, description="Base URL for LLM API (optional)")
    model: Optional[str] = Field(default=None, description="Model name for LLM calls (optional)")


class IntegratedReviewResponse(BaseModel):
    """Response model for integrated review data"""
    aggregated_summary: str
    aggregated_key_points: List[str]
    aggregated_questions: List[ReviewQuestion]
    aggregated_recommendations: List[ReviewRecommendation]
    aggregated_entities: List[ReviewEntity]
    next_review_date: str
    session_count: int
    total_questions: int
    total_recommendations: int
    sessions: List[Dict[str, Any]]


@router.post("/review/integrated/overview", response_model=IntegratedReviewResponse)
async def get_integrated_review(
    request: Optional[IntegratedReviewRequest] = None,
    db: Session = Depends(get_db)
):
    """
    Get integrated review data across multiple sessions.

    This endpoint aggregates review data from recent sessions to provide
    a comprehensive overview of learning topics, questions, and recommendations.
    It does not depend on a specific session selection.

    If force_refresh is True, it will trigger background regeneration for
    sessions that need updated review data before returning aggregated results.
    """
    if request is None:
        request = IntegratedReviewRequest()

    logger.info(f"Integrated review request with limit={request.limit}, days={request.days}, force_refresh={request.force_refresh}")

    # If force refresh is requested, check if we need to trigger regeneration
    if request.force_refresh:
        # Get recent sessions that have review data
        recent_reviews = crud.get_recent_valid_reviews(db, limit=request.limit, days=request.days)

        # Filter sessions that need regeneration (expired or no valid cache)
        sessions_needing_regeneration = []
        for review in recent_reviews:
            # Check if review is expired or about to expire (within 1 hour)
            if review.expires_at and review.expires_at <= datetime.now(timezone.utc) + timedelta(hours=1):
                sessions_needing_regeneration.append(review.session_id)

        # If no sessions need regeneration, check for sessions without review data
        if not sessions_needing_regeneration:
            # Get recent sessions without review data
            recent_sessions = crud.get_recent_sessions(db, limit=request.limit, days=request.days)
            for session in recent_sessions:
                review_data = crud.get_review_data(db, session.id)
                if not review_data or review_data.generation_status != "completed":
                    sessions_needing_regeneration.append(session.id)

        # Trigger background regeneration for sessions that need it
        if sessions_needing_regeneration:
            logger.info(f"Force refresh: triggering regeneration for {len(sessions_needing_regeneration)} sessions")

            # Schedule regeneration for each session
            task_ids = []
            for session_id in sessions_needing_regeneration[:5]:  # Limit to 5 sessions to avoid overload
                # Delete existing review data to force regeneration
                crud.delete_review_data(db, session_id)

                # Schedule regeneration with API configuration from request
                config = {
                    "priority": 20,  # High priority
                    "api_key": request.api_key,
                    "base_url": request.base_url,
                    "model": request.model
                }
                task_id = schedule_review_generation(session_id, config)
                task_ids.append({"session_id": session_id, "task_id": task_id})

            # Return 202 Accepted with task information
            return JSONResponse(
                status_code=202,
                content={
                    "message": "Review regeneration started for integrated overview",
                    "regenerating_sessions": sessions_needing_regeneration[:5],
                    "task_ids": task_ids,
                    "total_sessions": len(sessions_needing_regeneration),
                    "estimated_time": 300,  # 5 minutes estimate
                    "poll_url": f"/api/review/integrated/overview?limit={request.limit}&days={request.days}&force_refresh=false"
                }
            )

    try:
        # Get aggregated review data
        aggregated_data = crud.get_aggregated_review_data(
            db=db,
            session_ids=None,  # Use recent valid reviews
            limit=request.limit
        )

        # Convert entities to ReviewEntity objects
        aggregated_entity_objects = []
        for entity in aggregated_data.get("aggregated_entities", []):
            aggregated_entity_objects.append(
                ReviewEntity(
                    name=entity.get("name", ""),
                    type=entity.get("type", "concept"),
                    description=entity.get("description", ""),
                    mention_count=entity.get("mention_count", 1),
                    importance_score=entity.get("importance_score", 1.0),
                    is_recent=entity.get("is_recent", False)
                )
            )

        # Convert questions to ReviewQuestion objects
        aggregated_question_objects = []
        questions_data = aggregated_data.get("aggregated_questions", [])
        for i, q in enumerate(questions_data):
            aggregated_question_objects.append(
                ReviewQuestion(
                    id=q.get("id", i + 1),
                    question=q.get("question", f"Question {i+1}"),
                    options=q.get("options", ["Option A", "Option B", "Option C", "Option D"]),
                    correct_answer=q.get("correct_answer", 0),
                    explanation=q.get("explanation", ""),
                    difficulty=q.get("difficulty", "medium"),
                    entity_name=q.get("entity_name"),
                    entity_type=q.get("entity_type")
                )
            )

        # Convert recommendations to ReviewRecommendation objects
        aggregated_recommendation_objects = []
        recommendations_data = aggregated_data.get("aggregated_recommendations", [])
        for i, r in enumerate(recommendations_data):
            aggregated_recommendation_objects.append(
                ReviewRecommendation(
                    id=r.get("id", i + 1),
                    type=r.get("type", "review"),
                    title=r.get("title", f"Review Activity {i+1}"),
                    description=r.get("description", ""),
                    estimated_time=r.get("estimated_time", "10 minutes"),
                    due_date=r.get("due_date", ""),
                    priority=r.get("priority", "medium"),
                    completed=r.get("completed", False),
                    entity_name=r.get("entity_name")
                )
            )

        # Return integrated review response
        return IntegratedReviewResponse(
            aggregated_summary=aggregated_data.get("aggregated_summary", ""),
            aggregated_key_points=aggregated_data.get("aggregated_key_points", []),
            aggregated_questions=aggregated_question_objects,
            aggregated_recommendations=aggregated_recommendation_objects,
            aggregated_entities=aggregated_entity_objects,
            next_review_date=aggregated_data.get("next_review_date", datetime.now(timezone.utc).isoformat()),
            session_count=aggregated_data.get("session_count", 0),
            total_questions=aggregated_data.get("total_questions", 0),
            total_recommendations=aggregated_data.get("total_recommendations", 0),
            sessions=aggregated_data.get("sessions", [])
        )

    except Exception as e:
        logger.error(f"Error getting integrated review: {e}")
        raise HTTPException(
            status_code=500,
            detail=f"Failed to get integrated review: {str(e)}"
        )


@router.get("/review/integrated/sessions")
async def get_sessions_with_reviews(db: Session = Depends(get_db)):
    """Get list of sessions that have valid review data"""
    try:
        recent_reviews = crud.get_recent_valid_reviews(db, limit=50, days=30)

        sessions = []
        for review in recent_reviews:
            # Safely handle potentially None values
            generated_at = None
            if review.generated_at is not None:
                generated_at = review.generated_at.isoformat()

            expires_at = None
            if review.expires_at is not None:
                expires_at = review.expires_at.isoformat()

            # Handle JSON fields - use getattr to avoid type check issues
            key_points_data = getattr(review, 'key_points', None)
            questions_data = getattr(review, 'questions', None)
            recommendations_data = getattr(review, 'recommendations', None)
            summary_data = getattr(review, 'summary', None)

            key_points_list = []
            if key_points_data is not None and isinstance(key_points_data, list):
                key_points_list = key_points_data

            questions_list = []
            if questions_data is not None and isinstance(questions_data, list):
                questions_list = questions_data

            recommendations_list = []
            if recommendations_data is not None and isinstance(recommendations_data, list):
                recommendations_list = recommendations_data

            key_points_count = len(key_points_list)
            questions_count = len(questions_list)
            recommendations_count = len(recommendations_list)

            summary_text = ""
            if summary_data is not None and isinstance(summary_data, str):
                summary_text = summary_data

            if summary_text and len(summary_text) > 100:
                summary_preview = summary_text[:100] + "..."
            else:
                summary_preview = summary_text

            sessions.append({
                "session_id": review.session_id,
                "generated_at": generated_at,
                "expires_at": expires_at,
                "key_points_count": key_points_count,
                "questions_count": questions_count,
                "recommendations_count": recommendations_count,
                "summary_preview": summary_preview
            })

        return {
            "sessions": sessions,
            "total_count": len(sessions),
            "timestamp": datetime.now(timezone.utc).isoformat()
        }

    except Exception as e:
        logger.error(f"Error getting sessions with reviews: {e}")
        raise HTTPException(
            status_code=500,
            detail=f"Failed to get sessions with reviews: {str(e)}"
        )